<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Veyra — Desktop Studio" Width="1440" Height="920" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#0C0F15" Foreground="#F1F3F7" FontFamily="Segoe UI" FontSize="13" WindowStyle="None" ResizeMode="CanResizeWithGrip">
 <Window.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#B9ED80"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F3F7"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DDE2EA"/><Setter Property="Background" Value="#1D222D"/><Setter Property="BorderBrush" Value="#303745"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" RenderTransformOrigin=".5,.5"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="Opacity" To=".94" Duration="0:0:.14"/><DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-1" Duration="0:0:.14"/></Storyboard></BeginStoryboard></EventTrigger>
    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:.22"/><DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:.22"/></Storyboard></BeginStoryboard></EventTrigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".32"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,13"/><Setter Property="Margin" Value="0,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#151A24"/><Setter Property="Foreground" Value="#F0F3F8"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="#2A3241"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionBrush" Value="#49566B"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D4DBE7"/><Setter Property="Margin" Value="0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent" Cursor="Hand"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Border x:Name="Track" Grid.Column="1" CornerRadius="10" Width="34" Height="19" Background="#343D4E"><Ellipse x:Name="Knob" Width="13" Height="13" Fill="#ACB6C7" HorizontalAlignment="Left" Margin="3,0"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Knob" Property="Fill" Value="#142020"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="15" Duration="0:0:.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="PanningMode" Value="VerticalOnly"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#3B4557" CornerRadius="3" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#232B3A"/><Setter Property="Foreground" Value="White"/></Style>
 </Window.Resources>
 <Border BorderBrush="#303744" BorderThickness="1" CornerRadius="12">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#0E121A" BorderBrush="#222A37" BorderThickness="0,0,0,1">
   <Grid><StackPanel Orientation="Horizontal" Margin="21,0" VerticalAlignment="Center"><Image x:Name="BrandLogo" Width="22" Height="22"/><TextBlock Text="veyra" FontSize="16" FontWeight="SemiBold" Margin="11,0,20,0"/><TextBlock Text="ATMOSPHERE STUDIO" FontSize="9" Foreground="#66748C" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="#17211F" CornerRadius="5" Padding="9,4" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock x:Name="LiveBadge" Text="●  LOCAL WORKSPACE" FontSize="8" Foreground="#AAC8A8"/></Border><TextBlock Text="0.3.0 PREVIEW" FontSize="9" Foreground="#6C7A90" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="Minimize" Content="—" Padding="15,7" Background="Transparent" BorderThickness="0"/><Button x:Name="Maximize" Content="□" Padding="15,7" Background="Transparent" BorderThickness="0"/><Button x:Name="CloseApp" Content="✕" ToolTip="Keep Veyra running in the system tray" Padding="15,7" Background="Transparent" BorderThickness="0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="#222A37" BorderThickness="0,0,1,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#161A22" Offset="0"/><GradientStop Color="#10131B" Offset="1"/></LinearGradientBrush></Border.Background>
    <DockPanel Margin="14,26,14,18">
     <StackPanel DockPanel.Dock="Bottom"><Border Background="#17231F" CornerRadius="12" Padding="13" Margin="0,16,0,14"><StackPanel><TextBlock Text="One look. Your rhythm." Foreground="#C6D9C1" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Free &amp; open source.&#10;Designed to stay yours." Foreground="#7E948B" FontSize="10" LineHeight="17" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="NO ACCOUNT. NO SUBSCRIPTION." FontSize="7" Foreground="#526175" HorizontalAlignment="Center"/></StackPanel>
     <StackPanel><TextBlock Text="YOUR WORKSPACE" FontSize="8" Foreground="#61718A" Margin="13,0,0,15"/><Button x:Name="NavLibrary" Style="{StaticResource Nav}" Content="◫    Discover"/><Button x:Name="NavFavorites" Style="{StaticResource Nav}" Content="♡    Favorites"/><Button x:Name="NavFlow" Style="{StaticResource Nav}" Content="✦    Flow studio"/><Button x:Name="NavDesktop" Style="{StaticResource Nav}" Content="▣    Desktop studio"/><Button x:Name="NavCreator" Style="{StaticResource Nav}" Content="✧    Create a pack"/><Border Height="1" Background="#252E3D" Margin="13,21"/><TextBlock Text="TOGETHER" FontSize="8" Foreground="#61718A" Margin="13,0,0,12"/><Button x:Name="NavCommunity" Style="{StaticResource Nav}" Content="◎    Community"/><Button x:Name="NavSettings" Style="{StaticResource Nav}" Content="⚙    Preferences"/></StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" x:Name="PageHost" Margin="28,23,27,18"/>
  </Grid>
  <Border Grid.Row="2" Background="#0D121A" BorderBrush="#222A37" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><TextBlock DockPanel.Dock="Right" Text="MADE FOR YOUR WINDOWS" FontSize="8" Foreground="#61718A" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="Welcome to your next desktop." FontSize="10" Foreground="#91A0B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid></Border>
</Window>
